---
const {company} = Astro.props;
---

<header class="desktop-header">
    <nav class="desktop-nav">
        <a class="logo-wrap" href="/">
            <img class="logo" src="/images/logo.svg">
            {company}
        </a>
        <div class="divider-vert"></div>
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/services">Services</a>
        <a href="/contact">Contact</a>
    </nav>
</header>
<div class="nav-button">
    <img id="nav-open" src="/images/open.svg">
</div>
<header class="mobile-header">
    <nav class="mobile-nav">
        <a href="/">Home</a>
        <a href="/about">About</a>
        <a href="/services">Services</a>
        <a href="/contact">Contact</a>
    </nav>
</header>

<style>
    header {
        position: fixed;
        &.desktop-header {
            border: 1px solid var(--dark-90);
            z-index: 10;
            background-color: var(--dark-80-trans);
            padding: 8px 12px;
            margin-top: 16px;
            width: fit-content;
            height: fit-content;
            border-radius: var(--radius);
        }
        &.mobile-header {
            z-index: -1;
            display: none;
            width: 100%;
            height: 100%;
        }
    }
    
    .desktop-nav {
        width: fit-content;
        gap: 12px;
        align-items: center;
        a {
            text-decoration: none;
            color: var(--white-95);
            padding: 4px 12px;
            &:hover {
                color: var(--white-60)
            }
            &.logo-wrap {
                gap: 12px;
                padding: 0px 12px 0px 4px;
                align-items: center;
                &:hover {
                    .logo {
                        filter: brightness(60%);
                    }
                }
            }
        }
    }

    .mobile-nav {
        opacity: 0;
        background-color: var(--dark-90);
        width: 100%;
        height: 100%;
        flex-direction: column;
        align-items: center;
        padding-top: 48px;
        z-index: 10;
        a {
            text-decoration: none;
            color: var(--white-95);
            padding: 12px 12px;
            font-size: 32px;
        }
    }

    .divider-vert {
        background-color: var(--white-40);
        height: 90%;
        width: 1px;
    }

    .logo {
        aspect-ratio: 1;
        height: 28px;
    }

    .nav-button {
        display: none;
        background-color: var(--dark-90);
        border-radius: 8px;
        padding: 8px;
        z-index: 11;
        aspect-ratio: 1;
        height: fit-content;
        width: fit-content;
        position: absolute;
        top: 20px;
        right: 20px;
        img {
            width: 24px;
            height: 24px;
        }
    }

    @media only screen and (width < 900px) {
        header.mobile-header {
            display: flex;
        }
        header.desktop-header {
            display: none;
        }
        .nav-button {
            display: flex;
        }
    }
</style>

<script src="../scripts/nav.js"></script>