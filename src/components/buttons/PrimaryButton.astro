---
const {link,text} = Astro.props;
---

<a href={link}>
    <p class="p-large bold">{text}</p>
</a>

<style>
    a {
        text-decoration: none;
        background-color: var(--white-85);
        padding: 12px 24px;
        border-radius: 32px;
        color: black;
        border: solid 1px var(--white-85);
        width: fit-content;
        justify-content: center;

        &:hover {
            cursor: pointer;
            user-select: none;
            background-color: white;
            border-color: white;
            box-shadow: 0px 8px 16px var(--white-50-trans);
        }
    }

    @media only screen and (max-width: 900px) {
        a {
            width: 100%;
        }
    }
</style>